<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No app sandbox. Wellkept reads other apps' files and system state; sandboxing it would
	     remove the entire premise. This is also why it can never be a Mac App Store app. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
